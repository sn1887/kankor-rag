# WhatsApp channel switch
RAG_WHATSAPP_ENABLED=true

# Meta webhook verification/signature
RAG_WHATSAPP_VERIFY_TOKEN=replace-with-random-token
RAG_WHATSAPP_WEBHOOK_SECRET=replace-with-webhook-secret

# Meta Cloud API credentials
RAG_WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
RAG_WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
RAG_WHATSAPP_GRAPH_API_VERSION=v22.0

# Worker behavior
RAG_WHATSAPP_WORKER_CONCURRENCY=4
RAG_WHATSAPP_WORKER_POLL_SECONDS=1.0
RAG_WHATSAPP_HISTORY_TURNS=6
RAG_WHATSAPP_MAX_REPLY_CHARS=4000

# Backend selection (plug and play)
RAG_WHATSAPP_QUEUE_BACKEND=redis
RAG_WHATSAPP_PROCESSED_STORE_BACKEND=redis
RAG_WHATSAPP_CONVERSATION_STORE_BACKEND=redis
RAG_WHATSAPP_OUTBOUND_BACKEND=meta
RAG_WHATSAPP_MEDIA_BACKEND=meta
RAG_WHATSAPP_OCR_BACKEND=noop

# Redis config (used when any backend above is set to redis)
RAG_WHATSAPP_REDIS_URL=redis://127.0.0.1:6379/0
RAG_WHATSAPP_REDIS_KEY_PREFIX=kankor:whatsapp
RAG_WHATSAPP_PROCESSED_TTL_SECONDS=172800
RAG_WHATSAPP_CONVERSATION_TTL_SECONDS=604800

# Local dev alternatives:
# RAG_WHATSAPP_OUTBOUND_BACKEND=log
# RAG_WHATSAPP_MEDIA_BACKEND=noop

# Optional TOC manifest for chapter locator precision.
# RAG_TOC_MANIFEST_PATH=/app/data/index/kankor_gemini_pdf_window2/toc_manifest.jsonl
RAG_USE_V6_RETRIEVAL=false
RAG_V6_PAGE_LOCALIZATION_MIN_CONFIDENCE=0.4

# RAG context mode
RAG_LLM_BACKEND=gemini_native
RAG_CONTEXT_MODE=pdf_windows
RAG_PDF_WINDOW_MAX_ATTACHMENTS=6
RAG_PDF_WINDOW_MAX_PAGES_PER_ATTACHMENT=4
RAG_GEMINI_FALLBACK_MODEL_ID=gemini-2.0-flash
RAG_GEMINI_NATIVE_RETRY_ATTEMPTS=2
RAG_GEMINI_NATIVE_RETRY_DELAY_SECONDS=1.0
RAG_MAX_NEW_TOKENS=4096
RAG_MAX_NEW_TOKENS_HARD_LIMIT=6000
RAG_PDF_WINDOW_ADAPTIVE_ENABLED=true
RAG_PDF_WINDOW_ADAPTIVE_MIN_ATTACHMENTS=1
RAG_PDF_WINDOW_ADAPTIVE_TOP_SCORE_LOW=0.42
RAG_PDF_WINDOW_ADAPTIVE_TOP_SCORE_VERY_LOW=0.20
RAG_PDF_WINDOW_ADAPTIVE_SCORE_GAP_LOW=0.05
RAG_PDF_WINDOW_ADAPTIVE_COMPLEXITY_LENGTH_TOKENS=25
