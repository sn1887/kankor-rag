RAG_OPENAI_COMPAT_API_KEY=changeme
RAG_CHAT_API_KEY=
RAG_INDEX_PATH=/app/data/index/kankor_openai_full/index.faiss
RAG_DOCSTORE_PATH=/app/data/index/kankor_openai_full/metadata.jsonl
# Optional TOC manifest for topic-locator chapter/title queries.
# RAG_TOC_MANIFEST_PATH=/app/data/index/kankor_openai_full/toc_manifest.jsonl
RAG_VECTOR_STORE_BACKEND=faiss
RAG_LLM_BACKEND=openai
RAG_EMBEDDING_BACKEND=openai
RAG_OPENAI_MODEL_ID=gpt-4o-mini
RAG_OPENAI_EMBEDDING_MODEL_ID=text-embedding-3-small
RAG_OPENAI_API_KEY=<set-your-key>
OPENAI_API_KEY=<set-your-key>
# Gemini (optional)
# Gemini-native PDF grounding keeps the row-aligned docstore on metadata.jsonl
# and uses the flat toc_manifest.jsonl as the topic-locator sidecar.
# RAG_DOCSTORE_PATH=/app/data/index/kankor_gemini_pdf_window2/metadata.jsonl
# RAG_TOC_MANIFEST_PATH=/app/data/index/kankor_gemini_pdf_window2/toc_manifest.jsonl
# RAG_LLM_BACKEND=gemini_native
# RAG_EMBEDDING_BACKEND=gemini
# RAG_CONTEXT_MODE=pdf_windows
# RAG_PDF_WINDOW_MAX_ATTACHMENTS=3
# RAG_PDF_WINDOW_MAX_PAGES_PER_ATTACHMENT=4
# RAG_GEMINI_MODEL_ID=gemini-2.0-flash
# RAG_GEMINI_FALLBACK_MODEL_ID=gemini-2.0-flash
# RAG_GEMINI_NATIVE_RETRY_ATTEMPTS=2
# RAG_GEMINI_NATIVE_RETRY_DELAY_SECONDS=1.0
# RAG_GEMINI_EMBEDDING_MODEL_ID=text-embedding-004
# RAG_GEMINI_API_KEY=<set-your-key>
# GEMINI_API_KEY=<set-your-key>
# DeepSeek (optional)
# RAG_LLM_BACKEND=deepseek
# RAG_EMBEDDING_BACKEND=deepseek
# RAG_DEEPSEEK_MODEL_ID=deepseek-chat
# RAG_DEEPSEEK_EMBEDDING_MODEL_ID=deepseek-embedding
# RAG_DEEPSEEK_API_KEY=<set-your-key>
# DEEPSEEK_API_KEY=<set-your-key>
RAG_ALLOW_HASH_EMBEDDER_FALLBACK=false
RAG_USE_V6_RETRIEVAL=false
RAG_V6_PAGE_LOCALIZATION_MIN_CONFIDENCE=0.4
RAG_MAX_NEW_TOKENS=4096
RAG_MAX_NEW_TOKENS_HARD_LIMIT=6000
RAG_DEMO_MODE=false

# WhatsApp local profile (optional)
# RAG_WHATSAPP_ENABLED=true
# RAG_WHATSAPP_VERIFY_TOKEN=local-verify-token
# RAG_WHATSAPP_WEBHOOK_SECRET=local-webhook-secret
# RAG_WHATSAPP_QUEUE_BACKEND=redis
# RAG_WHATSAPP_PROCESSED_STORE_BACKEND=redis
# RAG_WHATSAPP_CONVERSATION_STORE_BACKEND=redis
# RAG_WHATSAPP_REDIS_URL=redis://redis:6379/0
# RAG_WHATSAPP_OUTBOUND_BACKEND=log
# RAG_WHATSAPP_MEDIA_BACKEND=noop
