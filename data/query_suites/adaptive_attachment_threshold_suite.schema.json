{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kankor-rag.local/schemas/adaptive_attachment_threshold_suite.schema.json",
  "title": "Adaptive Attachment Threshold Suite Row",
  "description": "Row schema for adaptive attachment threshold tuning suites.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "intent",
    "query",
    "expected_count"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "expected_count": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "allow_zero_hits": {
      "type": "boolean",
      "default": false
    }
  }
}
